{# AnnData footer block.

   Inputs:
   - version (str): anndata version string.
   - memory_str (str | None): human-readable memory size (e.g. "1.2 MB"); omitted
     when sizeof computation failed or for lazy objects.
   - memory_title (str): tooltip for the memory size.

   Role: produce `<div class="anndata-footer">`.
#}
<div class="anndata-footer">
  <span>anndata v{{ version }}</span>
  {%- if memory_str is not none %}
  <span title="{{ memory_title }}">~{{ memory_str }}</span>
  {%- endif %}
</div>
